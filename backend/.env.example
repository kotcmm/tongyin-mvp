# 开发环境：使用 `source .env` 导入变量，勿提交正式密钥。
LISTEN_ADDR=:8080
PUBLIC_URL=http://localhost:8080
DATA_DIR=./data

# 默认 PostgreSQL；上线使用 MySQL 时仅切换 DB_DRIVER 和 DATABASE_URL。
# 可选：postgres | mysql | file（file 仅用于本地 DEV_MODE=true）
DB_DRIVER=postgres
DATABASE_URL=postgres://tongyin:change_me@127.0.0.1:5432/tongyin?sslmode=disable
# MySQL 示例：设置 DB_DRIVER=mysql 并将 DATABASE_URL 改成：
# DATABASE_URL=tongyin:change_me@tcp(127.0.0.1:3306)/tongyin?charset=utf8mb4&parseTime=true
ADMIN_DIR=../admin
ADMIN_TOKEN=CHANGE_TO_LONG_RANDOM_ADMIN_TOKEN
SESSION_SECRET=CHANGE_TO_AT_LEAST_24_CHAR_RANDOM_SECRET
PRODUCT_PRICE_FEN=12900
# 形象生成：首次 1 张 + 可免费重新生成 1 次（总共 2 次），未来可扩展付费/广告次数
FREE_IMAGE_ATTEMPTS=2
DEV_MODE=true

# 正式发布配置
WX_APP_ID=
WX_APP_SECRET=
WX_MCH_ID=
WX_MCH_SERIAL=
WX_MCH_PRIVATE_KEY=/secure/path/apiclient_key.pem
WX_PLATFORM_PUBLIC_KEY=/secure/path/wechatpay_platform_cert_or_public_key.pem
WX_PLATFORM_SERIAL=
WX_PAY_API_V3_KEY=
WX_PAY_NOTIFY_URL=https://api.your-domain.com/api/pay/notify

# AI 异步 worker，没有配置时进入人工运营队列
AI_WORKER_URL=
AI_WORKER_TOKEN=
AI_WEBHOOK_TOKEN=
