page{background:#F6F5F1;color:#29342F;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;font-size:29rpx;box-sizing:border-box}
view,text,image,button,input,textarea{box-sizing:border-box}
.container{padding:36rpx 34rpx 80rpx}
.page-kicker{font-size:20rpx;color:#A07F71;font-weight:750;letter-spacing:4rpx;display:flex;align-items:center;gap:18rpx}
.kicker-line{height:2rpx;width:55rpx;background:#DFAE95}
.hero-title{font-size:62rpx;line-height:1.23;font-weight:820;letter-spacing:-2rpx;color:#28332E}
.sub{font-size:26rpx;line-height:1.65;color:#838680}
.card{background:#fff;border-radius:28rpx;padding:30rpx;margin-top:23rpx;box-shadow:0 8rpx 26rpx rgba(59,61,51,.035)}
.btn{display:block;width:100%;box-sizing:border-box;background:#EA7650;color:#fff;border:0;border-radius:22rpx;font-size:29rpx;font-weight:750;height:100rpx;line-height:100rpx;text-align:center;white-space:nowrap;overflow:hidden;padding:0 26rpx;box-shadow:0 12rpx 25rpx rgba(234,118,80,.18)}
.btn::after{border:0}.btn[disabled]{background:#D8CBC4;color:#fff;box-shadow:none}
.secondary-btn{background:#FCEDE5;color:#B6694B;border:0;border-radius:20rpx}.secondary-btn::after{border:0}
.section-title{font-size:39rpx;line-height:1.35;font-weight:790;margin:24rpx 0 12rpx;color:#29342F}
.muted{color:#96978F;font-size:24rpx;line-height:1.65}
.preview-image{width:100%;background:#F1F0EA;border-radius:20rpx;display:block}
.field{display:block;width:100%;background:#F8F7F4;border:2rpx solid #EEEBE6;border-radius:17rpx;padding:22rpx;margin:15rpx 0;font-size:28rpx;min-height:86rpx}
.tag{display:inline-block;background:#E6EEE6;color:#557761;border-radius:35rpx;padding:10rpx 19rpx;font-size:22rpx;font-weight:600}
.text-link{color:#D86F4B;font-size:25rpx;font-weight:650}
