/* 作品卡片：主信息左右排列，操作区独立占据底部整行。 */
.work-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.work-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 20rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 26rpx rgba(44,43,39,.035);
}
.work-main {
  display: flex;
  align-items: stretch;
  min-width: 0;
  gap: 23rpx;
}
.work-picture {
  position: relative;
  width: 210rpx;
  height: 236rpx;
  flex: 0 0 210rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #f1ebe3;
}
.work-picture image {
  display: block;
  width: 100%;
  height: 100%;
}
.picture-label {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 10rpx 5rpx;
  background: rgba(40,43,40,.55);
  color: #fff;
  font-size: 19rpx;
  text-align: center;
  white-space: nowrap;
}
.work-detail {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  padding: 7rpx 0 2rpx;
}
.status-pill {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  padding: 7rpx 12rpx;
  border-radius: 30rpx;
  background: #fff1e9;
  color: #ab5a3e;
  font-size: 21rpx;
  line-height: 1.35;
  white-space: nowrap;
}
.status-pill.ready { background: #e5f2e8; color: #36734c; }
.status-pill.action { background: #e8eee9; color: #466b57; }
.status-pill.failed { background: #f8e6e5; color: #a45d5c; }
.tiny-dot {
  width: 9rpx;
  height: 9rpx;
  flex: 0 0 9rpx;
  margin-right: 7rpx;
  border-radius: 50%;
  background: currentColor;
}
.work-title {
  margin-top: 15rpx;
  color: #29332d;
  font-size: 29rpx;
  font-weight: 750;
  line-height: 1.35;
  overflow-wrap: break-word;
}
.work-hint {
  margin-top: 7rpx;
  color: #8b8c86;
  font-size: 22rpx;
  line-height: 1.5;
}
.work-date {
  margin-top: auto;
  padding-top: 10rpx;
  color: #a4a49f;
  font-size: 20rpx;
  white-space: nowrap;
}

/* 行动区不挤压文字列：查看进度固定单行，删除是独立的小尺寸次要按钮。 */
.work-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 16rpx 5rpx 0;
  border-top: 1rpx solid #f4f0ed;
}
.work-link {
  display: inline-flex;
  flex: 1 1 auto;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
  color: #e57953;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.4;
  white-space: nowrap;
}
.work-arrow {
  font-size: 31rpx;
  line-height: 1;
}
.work-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 128rpx;
  box-sizing: border-box;
  width: 128rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #f1e5df;
  border-radius: 28rpx;
  background: #fbf4f1;
  box-shadow: none;
  color: #92695f;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
}
.work-delete::after { border: 0; }
.work-delete-hover { background: #f5e9e3; }
.work-delete[disabled] { opacity: .55; }
