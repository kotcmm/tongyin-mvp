.works-page{padding-top:40rpx}.head-row{display:flex;align-items:center;justify-content:space-between;margin:18rpx 0 42rpx}.page-title{font-size:66rpx;line-height:1.2;font-weight:800;letter-spacing:-2rpx;color:#252F2C}.title-dot{color:#EC754F}.add-circle{width:86rpx;height:86rpx;border-radius:50%;background:#EC754F;display:flex;align-items:center;justify-content:center;color:#fff;box-shadow:0 10rpx 23rpx rgba(236,117,79,.2)}.add-circle text{font-size:53rpx;line-height:1}.summary{display:flex;align-items:center;gap:24rpx;background:#EDEFE8;border-radius:25rpx;padding:28rpx 27rpx;margin-bottom:32rpx;color:#31413B}.summary-number{font-size:42rpx;font-weight:800;margin-right:7rpx}.summary-unit{font-size:23rpx}.summary-divider{height:43rpx;width:1rpx;background:#C8D1C5}.summary-note{flex:1;text-align:right;font-size:22rpx;color:#718079}.filter-scroll{white-space:nowrap;margin-bottom:26rpx}.filter-row{display:flex;gap:14rpx;padding-bottom:4rpx}.filter{padding:14rpx 27rpx;border-radius:40rpx;background:#fff;color:#7E8179;font-size:25rpx;white-space:nowrap;border:1rpx solid #EAE6DF}.filter.active{background:#2E4037;color:#fff;border-color:#2E4037;font-weight:600}.work-list{display:flex;flex-direction:column;gap:22rpx}.work-card{display:flex;gap:23rpx;background:#fff;border-radius:28rpx;padding:18rpx;box-shadow:0 8rpx 26rpx rgba(44,43,39,.035)}.work-picture{width:225rpx;height:250rpx;position:relative;border-radius:18rpx;background:#F1EBE3;flex-shrink:0;overflow:hidden}.work-picture image{width:100%;height:100%}.picture-label{position:absolute;bottom:0;left:0;right:0;background:rgba(40,43,40,.55);color:#fff;padding:10rpx;font-size:19rpx;text-align:center}.work-detail{flex:1;min-width:0;display:flex;flex-direction:column;align-items:flex-start;padding:10rpx 2rpx 6rpx}.status-pill{font-size:21rpx;padding:7rpx 12rpx;background:#FFF1E9;color:#AB5A3E;border-radius:30rpx;display:flex;align-items:center;gap:7rpx}.status-pill.ready{background:#E5F2E8;color:#36734C}.status-pill.action{background:#E8EEE9;color:#466B57}.status-pill.failed{background:#F8E6E5;color:#A45D5C}.tiny-dot{height:9rpx;width:9rpx;background:currentColor;border-radius:50%}.work-title{font-size:29rpx;font-weight:750;color:#29332D;line-height:1.35;margin-top:18rpx}.work-hint{font-size:22rpx;line-height:1.5;color:#8B8C86;margin-top:6rpx}.work-date{font-size:20rpx;color:#A4A49F;margin-top:12rpx}.work-link{margin-top:auto;font-size:24rpx;color:#E57953;font-weight:650;display:flex;align-items:center;gap:15rpx}.work-link text{font-size:34rpx}.loading-card,.empty-panel{background:#fff;border-radius:28rpx;padding:82rpx 25rpx;text-align:center;color:#888}.empty-panel .btn{margin-top:34rpx;width:85%}.empty-title{font-size:31rpx;font-weight:700;color:#2A332F;margin-bottom:16rpx}.empty-panel .muted{max-width:480rpx;margin:0 auto}.empty-art{width:160rpx;height:160rpx;margin:0 auto 30rpx;background:#F5E8DD;border-radius:32rpx;transform:rotate(-10deg);display:flex;align-items:center;justify-content:center;position:relative}.empty-art-inner{width:80rpx;height:80rpx;border:15rpx solid #E89975;border-radius:50%}.empty-art-dot{position:absolute;width:22rpx;height:22rpx;background:#98B6A2;border-radius:50%;right:16rpx;top:12rpx}.footer-note{text-align:center;color:#A2A39B;font-size:22rpx;padding:42rpx 0 8rpx}.outline-button{margin-top:25rpx;background:#EDEFE8;color:#365345;border-radius:50rpx;font-size:27rpx;border:0}.outline-button::after{border:0}
/* Verified WeChat session / DEV shared identity – subtle account card. */
.identity-card{display:flex;align-items:center;gap:19rpx;margin:-13rpx 0 31rpx;padding:22rpx 23rpx;border:1rpx solid #DFE8DC;border-radius:22rpx;background:#EDF3EA}
.identity-monogram{width:72rpx;height:72rpx;flex-shrink:0;border-radius:24rpx;background:#DBE9DA;display:flex;align-items:center;justify-content:center;color:#578266;font-size:30rpx;font-weight:750}
.identity-content{flex:1;min-width:0}
.identity-line{display:flex;align-items:center;gap:10rpx}
.identity-dot{width:12rpx;height:12rpx;flex-shrink:0;background:#719D78;border-radius:50%}
.identity-title{color:#47664F;font-size:25rpx;font-weight:750}
.identity-id{color:#5A715E;font-size:23rpx;margin-top:8rpx;letter-spacing:.5rpx}
.identity-description{font-size:21rpx;color:#93A192;margin-top:9rpx;line-height:1.5}
.identity-card.dev{background:#FFF4E7;border-color:#F3E4D1}
.identity-card.dev .identity-monogram{background:#F7E8D0;color:#A97C4C}
.identity-card.dev .identity-dot{background:#D3A16B}
.identity-card.dev .identity-title{color:#9C754D}
.identity-card.dev .identity-id{color:#A48263}
.identity-card.error{background:#FFF1ED;border-color:#F5DFD9}
.identity-card.error .identity-dot{background:#D78A74}
.identity-card.error .identity-title{color:#A76E59}
.identity-card.loading{background:#F1F2ED;border-color:#E6E8E2}
.identity-card.loading .identity-dot{background:#B5BFB2}
.identity-card.loading .identity-title{color:#87958A}
.identity-retry{font-size:23rpx;color:#A76E59;padding:15rpx 5rpx;flex-shrink:0}
