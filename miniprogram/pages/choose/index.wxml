<view class="container">
 <view class="section-title">选出最喜欢的形象</view>
 <view class="sub">尽量保留孩子原画里与众不同的模样。</view>
 <view wx:if="{{item && item.status==='image_pending'}}" class="card" style="text-align:center;padding:80rpx 25rpx"><view style="font-size:88rpx">🎨</view><view class="section-title">{{!aiAutoEnabled ? '作品已提交，等待制作' : '正在绘制立体形象'}}</view><view class="muted">{{!aiAutoEnabled && dev ? '当前未配置 AI 自动生成服务。请到运营后台为该作品上传两张候选图片，上传完成后此页会自动显示。' : !aiAutoEnabled ? '作品已收到，正在等待制作。完成后即可查看两张方案。' : 'AI 任务已提交，稍后会显示两个方案，可以先离开此页面。'}}</view></view>
 <view wx:elif="{{item && item.status==='failed'}}" class="card">生成未成功：{{item.note || '请联系客服处理'}}</view>
 <view wx:elif="{{item && item.status==='image_ready'}}">
  <view wx:for="{{item.candidates}}" wx:key="index" class="option {{selected===index?'active':''}}" data-index="{{index}}" bindtap="select">
   <image src="{{item}}" mode="aspectFit" class="candidate"/>
   <view class="choice"><text>方案 {{index+1}}</text><text>{{selected===index?'✓ 已选择':'点按选择'}}</text></view>
  </view>
  <button class="btn" disabled="{{selected<0 || busy}}" loading="{{busy}}" bindtap="confirm">用这个形象生成 3D</button>
 </view>
</view>
