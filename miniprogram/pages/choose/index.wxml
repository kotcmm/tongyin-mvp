<view class="container choose-page">
 <view class="page-kicker">STEP 02 / 03 <text class="kicker-line"></text> 形象设计</view>
 <view class="section-title choose-heading">给想象，<text class="accent">一个新模样.</text></view>
 <view class="sub">每次只生成一个形象。喜欢就继续，不满意可以重新生成。</view>
 <view wx:if="{{item && item.original}}" class="source-strip">
  <image class="source-thumb" src="{{item.original}}" mode="aspectFill"/>
  <view class="source-info"><view class="source-label">原始画作</view><view class="source-desc">从这一张画开始创作</view></view>
  <view class="source-mark">ORIGINAL</view>
 </view>
 <view wx:if="{{item && item.status==='image_pending'}}" class="waiting">
  <view class="waiting-visual"><view class="w-disc d1"></view><view class="w-disc d2"></view><view class="w-disc d3"></view><view class="w-disc d4"></view><view class="w-spark">✳</view></view>
  <view class="waiting-tag">STEP 02 · 形象设计</view>
  <view class="waiting-title">{{!aiAutoEnabled ? '作品已收到' : '正在为想象塑形'}}</view>
  <view class="waiting-desc">{{!aiAutoEnabled && dev ? '当前为人工处理模式，请在管理后台为作品上传1张形象图。' : !aiAutoEnabled ? '正在等待制作，完成后即可查看效果。' : '每次生成一张，完成后会显示在这里。'}}</view>
  <view class="wait-separator"></view>
  <view class="waiting-hint">不需要守在这里，作品会保存在「我的作品」中。</view>
  <view class="nav-action" bindtap="toWorks"><text>前往我的作品</text><text class="action-arrow">→</text></view>
 </view>
 <view wx:elif="{{item && item.status==='failed'}}" class="waiting">
  <view class="failed-icon">!</view><view class="waiting-title">这次还没有完成</view>
  <view class="waiting-desc">{{item.note || '作品需要重新处理。'}}</view>
  <view wx:if="{{canRetry}}" class="secondary-action" bindtap="retry">重新生成一次 <text>↻</text></view>
  <view wx:else class="quota-note">免费生成次数已用完，付费或广告重试暂未开放</view>
  <view class="nav-action" bindtap="toWorks"><text>返回我的作品</text><text class="action-arrow">→</text></view>
 </view>
 <view wx:elif="{{item && item.status==='image_ready'}}" class="result-wrap">
  <view class="pick-heading">你的立体形象 <text>这次生成了 1 张</text></view>
  <view class="single-result">
   <image src="{{item.candidates[0]}}" mode="aspectFit" class="result-image"/>
   <view class="result-caption"><view class="result-dot"></view><text>已生成 · 可直接制作 3D 白模</text></view>
  </view>
  <view class="primary-action {{busy?'is-busy':''}}" bindtap="confirm">
   <text>{{busy?'提交中…':'满意，用它生成 3D 白模'}}</text><text class="action-arrow">→</text>
  </view>
  <view wx:if="{{canRetry}}" class="secondary-action" bindtap="retry">不太满意 · 重新生成 <text>↻</text></view>
  <view wx:else class="quota-note">免费次数已用完，可以继续使用当前形象；付费或广告重试暂未开放</view>
  <view class="quota-hint">已生成 {{item.image_attempts || 1}} / {{maxAttempts}} 次（含本次）。重复生成会替换当前形象。</view>
  <view class="more-link" bindtap="toWorks">稍后再决定 · 返回我的作品</view>
 </view>
 <view wx:elif="{{loading}}" class="waiting"><view class="waiting-title">正在打开作品…</view></view>
</view>