/* WXML view-based actions: avoid native mini-program button line-height clipping. */
.nav-action,.primary-action,.secondary-action{width:100%;min-height:94rpx;display:flex;align-items:center;justify-content:center;gap:22rpx;box-sizing:border-box;border-radius:20rpx;font-size:28rpx;font-weight:750;line-height:1.35;white-space:nowrap;padding:18rpx 24rpx}
.nav-action{background:#304238;color:#fff;margin-top:28rpx}
.primary-action{background:#E87955;color:#fff;margin-top:28rpx}
.primary-action.is-busy{opacity:.6}
.secondary-action{background:#F5E9E1;color:#C97151;margin-top:17rpx}
.action-arrow{font-size:36rpx;line-height:1}
