<view class="container" wx:if="{{item}}">
 <view class="card"><view style="font-size:42rpx;font-weight:800;color:#E97B54">{{item.label}}</view><view class="muted" style="margin-top:12rpx">订单编号：{{item.id}}</view></view>
 <view class="card"><view class="section-title" style="margin-top:0">童印 · 白模定制</view><view style="display:flex;justify-content:space-between;margin-top:20rpx"><text>订单金额</text><text style="color:#E97B54;font-size:36rpx;font-weight:700">¥ {{item.price}}</text></view></view>
 <view class="card"><view class="section-title" style="margin-top:0">收货信息</view><view class="sub">{{item.name}} · {{item.phone}}</view><view class="sub">{{item.address}}</view><view wx:if="{{item.tracking}}" style="margin-top:20rpx">物流单号：{{item.tracking}}</view></view>
 <button wx:if="{{item.status==='awaiting_payment'}}" class="btn" loading="{{paying}}" disabled="{{paying}}" style="margin-top:35rpx" bindtap="pay">微信支付 ¥{{item.price}}</button>
 <view class="muted" style="margin-top:32rpx;text-align:center">支付结果以订单状态为准，支付完成后可返回本页刷新。</view>
</view>
