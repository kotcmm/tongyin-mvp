.order-page{padding-top:46rpx}.page-title{font-size:55rpx;margin-top:30rpx}.accent{color:#E87955}.status-card{margin-top:31rpx;background:#E9EFE8;border-radius:26rpx;padding:37rpx 30rpx}.status-kicker{letter-spacing:2rpx;font-size:20rpx;color:#78927B;font-weight:700}.current-status{font-size:45rpx;font-weight:820;color:#355542;margin:20rpx 0}.status-date{font-size:21rpx;color:#91A095;margin-top:17rpx}.detail-card{background:#fff;border-radius:27rpx;padding:30rpx;margin-top:22rpx}.detail-heading{font-size:31rpx;font-weight:780}.product-row{display:flex;gap:22rpx;align-items:center;margin-top:27rpx}.product-icon{width:124rpx;height:123rpx;border-radius:18rpx;background:#F1F2EB;position:relative;flex-shrink:0}.product-head{position:absolute;top:19rpx;left:30rpx;width:68rpx;height:64rpx;border-radius:50%;background:linear-gradient(125deg,#fff,#DCE1DA)}.product-body{position:absolute;bottom:13rpx;left:40rpx;width:51rpx;height:42rpx;border-radius:40% 40% 30% 30%;background:#DCE2DA}.product-title{font-weight:700;font-size:28rpx;margin-bottom:13rpx}.divider{height:1rpx;background:#EFEFEA;margin:29rpx 0}.amount{display:flex;align-items:center;justify-content:space-between;font-size:25rpx;color:#959B91}.amount view{font-size:38rpx;font-weight:800;color:#E87955}.address-name{font-size:28rpx;font-weight:700;margin-top:23rpx}.address-name text{font-weight:400;color:#90978F;margin-left:17rpx}.address{font-size:26rpx;line-height:1.65;color:#7D867D;margin-top:15rpx}.tracking{color:#4C7356;font-size:23rpx;margin-top:18rpx}.pay-btn{margin-top:28rpx;display:block;width:100%;text-align:center;white-space:nowrap}.under-link{text-align:center;font-size:25rpx;color:#D97755;font-weight:650;margin-top:32rpx}.under-link text{margin-left:10rpx}.foot{text-align:center;margin-top:30rpx;font-size:21rpx}
.shipping-heading{display:flex;justify-content:space-between;align-items:center;gap:15rpx}
.shipping-edit-link{color:#557B62;font-size:24rpx;padding:12rpx 4rpx;white-space:nowrap}
.shipping-help{font-size:21rpx;color:#9BA69B;line-height:1.55;margin-top:16rpx}
.edit-shipping{padding-top:17rpx}
.wechat-select{min-height:80rpx;background:#ECF5ED;color:#467254;border-radius:15rpx;padding:20rpx 23rpx;font-size:25rpx;font-weight:650;display:flex;align-items:center;justify-content:space-between;margin-bottom:22rpx}
.wechat-select text{font-size:31rpx;font-weight:400}
.edit-shipping-hint{color:#9AA49A;font-size:22rpx;margin-bottom:13rpx}
.edit-field{display:block;box-sizing:border-box;width:100%;height:86rpx;padding:20rpx 21rpx;background:#F7F8F5;border:1rpx solid #E2E8E0;border-radius:15rpx;font-size:26rpx;color:#334337;margin-top:16rpx}
.edit-address{height:160rpx;min-height:160rpx;line-height:1.55}
.edit-actions{display:flex;justify-content:flex-end;align-items:center;gap:35rpx;margin-top:24rpx}
.edit-cancel{color:#999E97;font-size:24rpx;padding:17rpx}
.edit-save{background:#E8F0E8;border-radius:15rpx;color:#3B6246;font-size:25rpx;font-weight:700;padding:19rpx 23rpx}
.existing-order-tip{font-size:23rpx;color:#68866F;text-align:center;margin-top:18rpx}

/* Authentic shipping status and timeline: no synthetic courier events. */
.logistics-card{margin-top:22rpx}
.tracking-header{display:flex;justify-content:space-between;align-items:center;gap:14rpx;padding:20rpx 0}
.tracking-company{color:#375641;font-size:29rpx;font-weight:750}
.tracking-number{color:#829485;font-size:22rpx;padding-top:12rpx;word-break:break-all}
.tracking-copy{color:#5E8065;font-size:23rpx;border:1rpx solid #D2E2D1;border-radius:20rpx;padding:10rpx 17rpx;flex-shrink:0}
.tracking-timeline{margin:12rpx 4rpx 15rpx 12rpx;border-left:3rpx solid #C8DAC8;padding-left:25rpx}
.tracking-event{position:relative;padding:0 0 28rpx;color:#708474}
.tracking-event:before{content:'';position:absolute;left:-34rpx;top:8rpx;width:14rpx;height:14rpx;border-radius:50%;background:#8AAC92}
.tracking-time{font-size:22rpx;color:#8D9A8E}
.tracking-context{font-size:25rpx;line-height:1.7;color:#344C3A;margin-top:7rpx}
.tracking-source{font-size:20rpx;color:#A5B1A5;margin-top:5rpx}
.tracking-empty{font-size:24rpx;line-height:1.8;color:#829385;padding:22rpx 0}
.tracking-footer{font-size:21rpx;color:#A4AFA5}
.refund-notice{color:#B97B57;font-size:24rpx}

.cancel-order-link{padding:24rpx 16rpx;text-align:center;color:#B77F6A;font-size:24rpx;text-decoration:underline}
.payment-status-hint{font-size:21rpx;color:#B48B65;text-align:center;line-height:1.7;padding:18rpx 10rpx}
