<page-meta page-style="{{fullscreen ? 'overflow:hidden;' : ''}}"></page-meta>
<view class="container preview-page">
 <view class="page-kicker">STEP 03 / 03 <text class="kicker-line"></text> 3D 白模</view>
 <view class="section-title preview-title">看看它的<text class="accent">立体模样.</text></view>
 <view class="sub">这就是即将变成白色实物的造型。</view>
 <view wx:if="{{item && item.status==='model_pending' && !item.model}}" class="waiting">
  <view class="orbit"><view class="orb-head"></view><view class="orb-body"></view><view class="orb-base"></view><view class="orb-star">✦</view></view>
  <view class="waiting-kicker">FINAL STEP · 白模准备</view>
  <view class="waiting-title">{{!aiAutoEnabled ? '正在准备你的白模' : '立体形象正在成型'}}</view>
  <view class="waiting-desc">{{!aiAutoEnabled && dev ? '当前为人工处理模式，请在管理后台上传 GLB 模型，上传后即可预览。' : !aiAutoEnabled ? '已记录你的选择，白模准备好后可以回来确认。' : '正在生成模型。稍后到我的作品继续查看。'}}</view>
  <view class="waiting-hint">不需要一直停留，制作进度会保存在我的作品里。</view>
  <view class="nav-action" bindtap="toWorks"><text>查看我的作品</text><text>→</text></view>
 </view>
 <view wx:elif="{{item && item.status==='failed'}}" class="waiting"><view class="waiting-title">这次还没有完成</view><view class="waiting-desc">{{item.note || '模型需要重新处理，请稍后查看。'}}</view><view class="nav-action" bindtap="toWorks"><text>前往我的作品</text><text>→</text></view></view>
 <view wx:elif="{{item && item.model}}">
  <view class="preview-gallery {{fullscreen ? 'fullscreen-gallery' : ''}}">
   <view class="gallery-top">
    <view class="gallery-label">{{fullscreen ? '放大查看白模细节' : '你的专属 3D 白模'}}</view>
    <view class="gallery-actions">
     <view class="expand-action" hover-class="expand-action-pressed" role="button"
       aria-label="{{fullscreen ? '退出全屏' : '全屏查看'}}" catchtap="toggleFullscreen">
      <view wx:if="{{!fullscreen}}" class="expand-icon" aria-hidden="true">
       <view class="expand-corner corner-tl"></view>
       <view class="expand-corner corner-tr"></view>
       <view class="expand-corner corner-bl"></view>
       <view class="expand-corner corner-br"></view>
      </view>
      <text wx:else class="expand-close-icon">×</text>
      <text>{{fullscreen ? '退出全屏' : '全屏查看'}}</text>
     </view>
    </view>
   </view>
   <view class="model-stage">
    <canvas wx:if="{{showCanvas}}" type="webgl" id="modelCanvas" class="model-canvas"
      bindtouchstart="canvasTouchStart" catchtouchmove="canvasTouchMove"
      bindtouchend="canvasTouchEnd" bindtouchcancel="canvasTouchEnd"></canvas>
    <view wx:if="{{viewerLoading}}" class="model-message">{{viewerMessage}}</view>
    <view wx:if="{{viewerError}}" class="model-error">
     <view>当前 3D 模型未能显示</view>
     <view class="model-error-detail">{{viewerError}}</view>
     <view class="model-retry" bindtap="retryViewer">重新加载模型 →</view>
    </view>
   </view>
   <view wx:if="{{fullscreen}}" class="model-toolbar">
    <view class="model-tool" catchtap="zoomOut">－ 缩小</view>
    <view class="model-tool" catchtap="zoomIn">＋ 放大</view>
    <view class="model-tool" catchtap="resetView">重置视角</view>
   </view>
   <view class="gallery-bottom">单指旋转 · 双指缩放 <text>◦ 白色 PLA 打印</text></view>
  </view>
  <view class="product-note"><view class="note-symbol">✳</view><view><view class="note-title">留白，留给孩子的创造力</view><view class="note-desc">收到白色模型后，可以自行涂色，继续完成自己的作品。</view></view></view>
  <view class="checkout">
   <view class="checkout-head"><view><view class="checkout-kicker">CUSTOM MADE · 专属定制</view><view class="checkout-title">童印立体白模</view><view class="checkout-sub">一件作品 · 一份专属回忆</view></view><view class="checkout-price"><text>¥</text>{{price}}</view></view>
   <view class="divider"></view>
   <view class="shipping-header">
    <view class="field-label">收货地址</view>
    <view wx:if="{{shippingExists && !shippingEditing}}" class="address-change" bindtap="changeShipping">{{existingOrder ? '修改订单地址' : '更换 / 编辑'}} <text>›</text></view>
   </view>
   <view wx:if="{{!shippingLoaded}}" class="shipping-loading">正在读取保存的收货地址…</view>
   <view wx:elif="{{shippingExists && !shippingEditing}}" class="shipping-summary" bindtap="changeShipping">
    <view class="shipping-icon">⌖</view>
    <view class="shipping-content">
     <view class="shipping-person">{{name}}　{{phone}}</view>
     <view class="shipping-location">{{address}}</view>
     <view class="shipping-desc">{{existingOrder ? '此订单使用的收货地址' : '已保存，下次下单可直接使用'}}</view>
    </view>
    <view class="shipping-arrow">›</view>
   </view>
   <view wx:else class="shipping-editor">
    <view class="shipping-wechat" bindtap="chooseWeChatAddress">
     <view class="wechat-symbol">微</view>
     <view class="wechat-text"><view>选择微信收货地址</view><view class="wechat-sub">一键带入姓名、电话和地址</view></view>
     <view class="shipping-arrow">›</view>
    </view>
    <view class="shipping-manual-label">或者手动填写</view>
    <input class="field" placeholder="收件人姓名" value="{{name}}" bindinput="name" maxlength="30"/>
    <input class="field" placeholder="联系电话" value="{{phone}}" bindinput="phone" type="number" maxlength="20"/>
    <textarea class="field address-field" placeholder="详细地址（省市区、街道门牌号）" value="{{address}}" bindinput="address" maxlength="300"/>
    <view class="shipping-editor-actions">
     <view class="shipping-save" bindtap="saveShipping">{{shippingSaving ? '保存中…' : '保存为常用地址'}}</view>
     <view wx:if="{{shippingExists}}" class="shipping-cancel" bindtap="loadShipping">取消修改</view>
    </view>
   </view>
   <view class="fine-print">按所选造型定制。3D 打印层纹和局部细节可能与预览略有差异。</view>
   <view wx:if="{{existingOrder && existingOrder.status==='awaiting_payment'}}" class="existing-order-tip">此作品已有待付款订单，无需重复下单。</view>
   <view wx:if="{{existingOrder && existingOrder.status!=='awaiting_payment'}}" class="existing-order-tip">此作品已有订单，可直接查看订单进度。</view>
   <view wx:if="{{orderLookupFailed}}" class="existing-order-tip order-check-error" bindtap="loadExistingOrder">订单状态获取失败，点击重试</view>
   <button class="btn checkout-btn" disabled="{{busy || checkingOrder || orderLookupFailed || (!existingOrder && (!shippingLoaded || shippingSaving || !name || !phone || !address))}}" loading="{{busy || checkingOrder}}" bindtap="submit">{{existingOrder ? (existingOrder.status==='awaiting_payment' ? '继续付款' : '查看订单') : '确认定制，去付款'}} <text>→</text></button>
  </view>
  <view class="go-back" bindtap="toWorks">先不下单？作品会为你保留 →</view>
 </view>
</view>