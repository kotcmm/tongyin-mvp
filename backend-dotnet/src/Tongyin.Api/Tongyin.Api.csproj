<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Tongyin.Domain/Tongyin.Domain.csproj" />
    <ProjectReference Include="../Tongyin.Application/Tongyin.Application.csproj" />
    <ProjectReference Include="../Tongyin.Infrastructure/Tongyin.Infrastructure.csproj" />
    <Content Include="../../../backend/webadmin/*" Link="wwwroot/admin/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../admin/**" Link="wwwroot/admin/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
